root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_code_style = intellij_idea
# Platform test classes name their methods testXxx (JUnit 3 style), and JUnit 5 tests use backticked names.
ktlint_function_naming_ignore_when_annotated_with = Test

[*.properties]
# Resource bundles are read as UTF-8 by the platform.
charset = utf-8
