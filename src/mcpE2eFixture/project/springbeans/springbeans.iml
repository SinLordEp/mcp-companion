<?xml version="1.0" encoding="UTF-8"?>
<!-- mc_spring_beans fixture: a small Spring Boot application (annotated components, @Configuration with @Bean methods,
     constructor, field and setter injection, a profile, an injection point with two candidates and one with none, and
     an XML context). The Spring jars come from Gradle's dependency cache; runIdeForMcpE2e copies them into lib/spring. -->
<module type="JAVA_MODULE" version="4">
  <component name="NewModuleRootManager" inherit-compiler-output="true">
    <exclude-output />
    <content url="file://$MODULE_DIR$">
      <sourceFolder url="file://$MODULE_DIR$/src" isTestSource="false" />
      <sourceFolder url="file://$MODULE_DIR$/resources" type="java-resource" />
    </content>
    <orderEntry type="inheritedJdk" />
    <orderEntry type="sourceFolder" forTests="false" />
    <orderEntry type="library" name="spring" level="project" />
  </component>
</module>
