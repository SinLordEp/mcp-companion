<!-- Loaded only when the platform's VCS support is present (optional dependency in plugin.xml): its content module
     intellij.platform.vcs.impl holds CodeSmellDetector, which mc_diagnostics uses to analyse files without an editor. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.github.sinlordep.mcpcompanion">
        <fileAnalyzer implementation="com.github.sinlordep.mcpcompanion.diagnostics.vcs.CodeSmellFileAnalyzerProvider"/>
    </extensions>
</idea-plugin>
