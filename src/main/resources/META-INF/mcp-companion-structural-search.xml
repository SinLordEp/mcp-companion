<!-- Loaded only when the IDE's Structural Search plugin is present (optional dependency in plugin.xml): its content
     module intellij.platform.structuralSearch holds the matcher and the search templates behind
     mc_structural_search. The languages it reads templates in come from their own plugins (Java, Kotlin, XML,
     ...). -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij.mcpServer">
        <mcpToolset implementation="com.github.sinlordep.mcpcompanion.toolsets.structuralsearch.StructuralSearchToolset"/>
    </extensions>
</idea-plugin>
