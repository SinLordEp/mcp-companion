<!-- Loaded only when the Java plugin is present (optional dependency in plugin.xml). -->
<idea-plugin>
    <extensions defaultExtensionNs="com.github.sinlordep.mcpcompanion">
        <qualifiedNameLocator
                implementation="com.github.sinlordep.mcpcompanion.common.symbols.java.JavaQualifiedNameLocatorProvider"/>
        <localDeclarations
                implementation="com.github.sinlordep.mcpcompanion.common.source.java.JvmLocalDeclarationDetector"/>
        <safeDeleteSupport
                implementation="com.github.sinlordep.mcpcompanion.safedelete.java.JvmSafeDeleteSupport"/>
        <classMove implementation="com.github.sinlordep.mcpcompanion.move.java.JavaClassMoveSupport"/>
        <signatureChange
                implementation="com.github.sinlordep.mcpcompanion.changesignature.java.JavaSignatureChangeSupport"/>
        <superDeclarations
                implementation="com.github.sinlordep.mcpcompanion.navigation.implementations.java.JvmSuperDeclarationProvider"/>
        <typeHierarchy
                implementation="com.github.sinlordep.mcpcompanion.navigation.hierarchy.java.JvmTypeHierarchyProvider"/>
        <hotSwapSupport implementation="com.github.sinlordep.mcpcompanion.run.java.JvmHotSwapSupport"/>
        <codeRunGuard implementation="com.github.sinlordep.mcpcompanion.run.java.JvmAbstractTestGuard"/>
        <deferredFixes implementation="com.github.sinlordep.mcpcompanion.quickfix.java.JavaDeferredFixes"/>
        <moduleFacts implementation="com.github.sinlordep.mcpcompanion.modules.java.JvmModuleFacts"/>
        <moduleBuilder implementation="com.github.sinlordep.mcpcompanion.build.java.JvmModuleBuilderProvider"/>
    </extensions>
</idea-plugin>
